# Copy this content into the Streamlit Cloud dashboard under "Secrets"
# (App settings → Secrets → paste everything below)

# ── Garmin ────────────────────────────────────────────────────────────────────
GARMIN_EMAIL    = "your@email.com"
GARMIN_PASSWORD = "your_garmin_password"

# ── Strava ────────────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID     = "12345"
STRAVA_CLIENT_SECRET = "your_client_secret"
STRAVA_REFRESH_TOKEN = "your_refresh_token"

# ── GitHub (keeps your run history across restarts) ───────────────────────────
# Create a token at: https://github.com/settings/tokens
# Scopes needed: repo (full)
GITHUB_TOKEN     = "ghp_xxxxxxxxxxxxxxxxxxxx"
GITHUB_REPO      = "your-username/fatigue-detector"
GITHUB_BRANCH    = "main"
GITHUB_FILE_PATH = "src/classified_runs.csv"
